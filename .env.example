# Banco PostgreSQL criado dentro do mesmo projeto Railway.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeboard"

# GitHub OAuth App. O callback de producao sera:
# https://dashboard-ia-dev-production.up.railway.app/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_SLUG=""
GITHUB_WEBHOOK_SECRET=""
ADMIN_GITHUB_LOGIN="dashboardia"
# Logins GitHub autorizados no beta fechado, separados por vírgula.
BETA_ALLOWED_GITHUB_LOGINS=""

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Mesma chave em todos os serviços web e workers que compartilham o banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=""

# A liberação pública só é aceita quando cada execução roda em container isolado.
PUBLIC_EXECUTIONS_ENABLED="false"
EXECUTION_ISOLATION_MODE="trusted-worker"

# Integracoes habilitadas em blocos posteriores.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
SUPPORT_AI_MODEL="gpt-5.6-luna"

# Checkout hospedado, assinaturas e webhooks do Asaas. Comece em sandbox.
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY=""
# Token exclusivo do webhook, entre 32 e 255 caracteres. Não use a API Key.
ASAAS_WEBHOOK_TOKEN=""
BILLING_CONTACT_URL=""
RAILWAY_API_TOKEN=""
# RAILWAY_SERVICE_ID e RAILWAY_ENVIRONMENT_ID são injetadas automaticamente no Railway.
# Host Docker isolado mantido pelo Dashboardia para previews temporários.
PREVIEW_HOST_URL=""
# Gere com: openssl rand -hex 32
PREVIEW_HOST_TOKEN=""
PREVIEW_TTL_MINUTES="60"
# Limite do tarball baixado do GitHub antes de enviar ao host de preview.
# Padrão: 512 MB. Aceita até 2048 MB se a infraestrutura for ampliada.
GITHUB_ARCHIVE_MAX_MB="512"
BUCKET_ENDPOINT=""
BUCKET_NAME=""
BUCKET_ACCESS_KEY_ID=""
BUCKET_SECRET_ACCESS_KEY=""
WORKER_POLL_INTERVAL_MS="5000"
HEALTH_CHECK_INTERVAL_MS="300000"
HEALTH_CHECK_RETENTION_DAYS="30"
WORKER_HEARTBEAT_INTERVAL_MS="30000"

PREVIEW_HOST_TOKEN=gere-um-token-com-openssl-rand-hex-32
PREVIEW_BASE_DOMAIN=preview.dashboardia.app
PREVIEW_API_DOMAIN=preview-api.dashboardia.app
ACME_EMAIL=contato@dashboardia.app

# Suporte a repositórios grandes. O padrão é 512 MB compactados e pode ser
# ajustado até 2 GB se a infraestrutura tiver disco/memória suficientes.
PREVIEW_MAX_ARCHIVE_MB=512
PREVIEW_BUILD_TIMEOUT_MINUTES=15
PREVIEW_MAX_PARALLEL_BUILDS=2

# Execução isolada de install, lint, testes e build.
VALIDATION_MAX_ARCHIVE_MB=512
VALIDATION_MAX_PARALLEL=2
VALIDATION_RETENTION_HOURS=24
VALIDATION_MAX_OUTPUT_KB=96

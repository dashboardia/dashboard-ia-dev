FROM node:22-bookworm-slim AS dependencies

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npm ci && npx playwright install chromium

FROM node:22-bookworm-slim AS worker

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git maven default-jdk-headless python3 python3-pip python3-venv tar \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /ms-playwright /ms-playwright

# O código da plataforma pertence ao root e fica somente leitura para o usuário
# do worker. Código de repositórios clientes é manipulado apenas nos workspaces
# temporários em /tmp, evitando persistência dentro da própria aplicação.
COPY --chown=root:root . .
RUN ./node_modules/.bin/prisma generate \
  && npx playwright install-deps chromium \
  && chmod -R a-w /app \
  && chmod -R a+rX /app

USER node
CMD ["npm", "run", "worker:start"]

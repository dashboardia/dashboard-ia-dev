{
  "name": "dashboard-ia-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node --max-old-space-size=384 ./node_modules/next/dist/bin/next build --webpack",
    "start": "node scripts/start.mjs",
    "worker": "node scripts/validate-worker.mjs && node worker/index.mjs",
    "worker:start": "node scripts/validate-worker.mjs && prisma migrate deploy && node worker/index.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@openai/agents": "^0.15.0",
    "@prisma/client": "^6.19.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "openai": "^7.4.0",
    "pdfkit": "^0.19.1",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.1",
    "prisma": "^6.19.3",
    "vitest": "^4.1.10"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectProvider {
  GITHUB
  AZURE_DEVOPS
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DISCONNECTED
}

enum ProjectRole {
  MANAGER
  DEVELOPER
  VIEWER
}

enum DemandType {
  BUG
  FEATURE
  REFACTOR
  TEST
  INVESTIGATION
  DOCUMENTATION
}

enum DemandPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DemandStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  QUEUED
  RUNNING
  REVIEW
  SUCCEEDED
  FAILED
  CANCELLED
  STOPPED
}

enum ExecutionStatus {
  QUEUED
  PREPARING
  RUNNING
  VALIDATING
  WAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  STOPPED
}

enum ExecutionStage {
  ANALYSIS
  IMPLEMENTATION
  VALIDATION
  PUBLISH
}

enum PreviewEnvironmentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  READY
  FAILED
  STOPPING
  EXPIRED
}

enum PullRequestStatus {
  DRAFT
  OPEN
  MERGED
  CLOSED
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum BillingPlan {
  TRIAL
  STUDIO
  AGENCY
  CUSTOM
}

enum BillingStatus {
  TRIALING
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum CreditBucketType {
  TRIAL
  MONTHLY
  ADDITIONAL
  ADJUSTMENT
}

enum CreditTransactionType {
  GRANT
  RESERVE
  RELEASE
  CONSUME
  EXPIRE
  ADJUSTMENT
}

enum CreditReservationStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum BillingCheckoutKind {
  PLAN
  CREDIT_PACK
}

enum BillingCheckoutStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  FAILED
}

model User {
  id                  String          @id @default(cuid())
  name                String?
  email               String?         @unique
  emailVerified       DateTime?
  image               String?
  githubLogin         String?         @unique
  globalRole          GlobalRole      @default(USER)
  status              UserStatus      @default(ACTIVE)
  theme               String          @default("SYSTEM")
  locale              String          @default("pt-BR")
  accounts            Account[]
  sessions            Session[]
  projectMemberships  ProjectMember[]
  projectsCreated     Project[]       @relation("ProjectCreator")
  demandsCreated      Demand[]        @relation("DemandCreator")
  demandsApproved     Demand[]        @relation("DemandApprover")
  executionsRequested Execution[]     @relation("ExecutionRequester")
  executionsApproved  Execution[]     @relation("ExecutionApprover")
  auditLogs           AuditLog[]
  billingAccount      BillingAccount?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                   String          @id @default(cuid())
  name                 String
  slug                 String          @unique
  provider             ProjectProvider @default(GITHUB)
  repositoryFullName   String
  repositoryId         String?
  defaultBranch        String          @default("main")
  githubInstallationId String?
  githubWebhookId      String?
  githubWebhookAt      DateTime?
  githubWebhookError   String?         @db.Text
  productionUrl        String?
  railwayProjectId     String?
  railwayEnvironmentId String?
  railwayServiceId     String?
  workingDirectory     String          @default(".")
  installCommand       String?
  lintCommand          String?
  testCommand          String?
  buildCommand         String?
  previewCommand       String?
  previewPort          Int?
  status               ProjectStatus   @default(ACTIVE)
  createdById          String
  createdBy            User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members              ProjectMember[]
  demands              Demand[]
  pullRequests         PullRequest[]
  healthChecks         HealthCheck[]
  auditLogs            AuditLog[]
  webhookEvents        WebhookEvent[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([provider, repositoryFullName])
  @@index([status])
  @@index([createdById])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model Demand {
  id                 String         @id @default(cuid())
  projectId          String
  createdById        String
  approvedById       String?
  title              String
  description        String         @db.Text
  acceptanceCriteria String?        @db.Text
  visualValidation   Boolean        @default(false)
  visualPaths        Json?
  aiModel            String         @default("gpt-5.6-terra")
  type               DemandType
  priority           DemandPriority @default(NORMAL)
  status             DemandStatus   @default(DRAFT)
  approvedAt         DateTime?
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User           @relation("DemandCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?          @relation("DemandApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  executions         Execution[]
  pullRequests       PullRequest[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([projectId, status])
  @@index([createdById])
  @@index([createdAt])
}

model Execution {
  id                 String                      @id @default(cuid())
  demandId           String
  requestedById      String
  approvedById       String?
  status             ExecutionStatus             @default(QUEUED)
  stage              ExecutionStage              @default(ANALYSIS)
  branchName         String?
  baseSha            String?
  headSha            String?
  model              String?
  summary            String?                     @db.Text
  error              String?                     @db.Text
  inputTokens        Int?
  outputTokens       Int?
  attempts           Int                         @default(0)
  cancelRequestedAt  DateTime?
  stopRequestedAt    DateTime?
  lockedAt           DateTime?
  lockedBy           String?
  startedAt          DateTime?
  finishedAt         DateTime?
  demand             Demand                      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  requestedBy        User                        @relation("ExecutionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy         User?                       @relation("ExecutionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  logs               ExecutionLog[]
  artifacts          ExecutionArtifact[]
  pullRequest        PullRequest?
  financialSnapshot  ExecutionFinancialSnapshot?
  creditReservation  ExecutionCreditReservation?
  creditTransactions CreditTransaction[]
  previewEnvironment PreviewEnvironment?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([status, createdAt])
  @@index([demandId])
}

model PreviewEnvironment {
  id              String                   @id @default(cuid())
  executionId     String                   @unique
  status          PreviewEnvironmentStatus @default(QUEUED)
  provider        String                   @default("DASHBOARDIA")
  externalId      String?                  @unique
  url             String?
  runtime         String?
  imageReference  String?
  port            Int?
  attempts        Int                      @default(0)
  error           String?                  @db.Text
  requestedAt     DateTime                 @default(now())
  startedAt       DateTime?
  readyAt         DateTime?
  expiresAt       DateTime
  stoppedAt       DateTime?
  lastHeartbeatAt DateTime?
  execution       Execution                @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, expiresAt])
  @@index([provider, externalId])
}

model BillingAccount {
  id                     String                       @id @default(cuid())
  ownerUserId            String                       @unique
  trialIdentity          String                       @unique
  plan                   BillingPlan                  @default(TRIAL)
  pendingPlan            BillingPlan?
  status                 BillingStatus                @default(TRIALING)
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  cycleStartedAt         DateTime?
  cycleEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean                      @default(false)
  provider               String?                      @default("ASAAS")
  providerCustomerId     String?                      @unique
  providerSubscriptionId String?                      @unique
  creditDebt             Int                          @default(0)
  owner                  User                         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  creditBuckets          CreditBucket[]
  creditTransactions     CreditTransaction[]
  creditReservations     ExecutionCreditReservation[]
  checkouts              BillingCheckout[]
  trialOrganizations     BillingTrialOrganization[]
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@index([status, plan])
}

model BillingTrialOrganization {
  id          String         @id @default(cuid())
  githubOwner String         @unique
  accountId   String
  account     BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([accountId])
}

model CreditBucket {
  id           String              @id @default(cuid())
  accountId    String
  type         CreditBucketType
  granted      Int
  remaining    Int
  reserved     Int                 @default(0)
  expiresAt    DateTime
  sourceRef    String?             @unique
  account      BillingAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId, expiresAt])
}

model CreditTransaction {
  id          String                @id @default(cuid())
  accountId   String
  bucketId    String?
  executionId String?
  type        CreditTransactionType
  amount      Int
  balance     Int?
  description String?
  metadata    Json?
  account     BillingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bucket      CreditBucket?         @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  execution   Execution?            @relation(fields: [executionId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@index([accountId, createdAt])
  @@index([executionId])
}

model ExecutionCreditReservation {
  id               String                  @id @default(cuid())
  executionId      String                  @unique
  accountId        String
  status           CreditReservationStatus @default(RESERVED)
  reservedCredits  Int
  consumedCredits  Int                     @default(0)
  uncoveredCredits Int                     @default(0)
  allocations      Json
  execution        Execution               @relation(fields: [executionId], references: [id], onDelete: Cascade)
  account          BillingAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  settledAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([accountId, status])
}

model BillingCheckout {
  id                 String                @id @default(cuid())
  accountId          String
  kind               BillingCheckoutKind
  targetPlan         BillingPlan?
  creditAmount       Int?
  amountCents        Int
  status             BillingCheckoutStatus @default(PENDING)
  providerCheckoutId String?               @unique
  providerLink       String?
  expiresAt          DateTime?
  paidAt             DateTime?
  account            BillingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([accountId, status])
}

model BillingWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  error           String?   @db.Text
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([processedAt, createdAt])
}

model ExecutionFinancialSnapshot {
  id                               String    @id @default(cuid())
  executionId                      String    @unique
  mode                             String    @default("SHADOW")
  formulaVersion                   String
  calculationStatus                String
  model                            String
  inputTokens                      Int       @default(0)
  outputTokens                     Int       @default(0)
  inputPriceUsdMicrosPerMillion    Int
  outputPriceUsdMicrosPerMillion   Int
  aiCostUsdMicros                  Int
  usdToBrlCents                    Int
  aiSafetyPercent                  Int
  adjustedAiCostBrlCents           Int
  workerDurationSeconds            Int
  workerCostBrlCents               Int
  visualValidationCostBrlCents     Int
  totalInternalCostBrlCents        Int
  simulatedReservedCredits         Int
  simulatedConsumedCredits         Int
  simulatedCommercialValueBrlCents Int
  estimatedGrossMarginBasisPoints  Int
  targetGrossMarginPercent         Int
  wouldCharge                      Boolean   @default(false)
  pricingMetadata                  Json?
  execution                        Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  calculatedAt                     DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  @@index([calculatedAt])
  @@index([mode, calculationStatus])
}

model ExecutionLog {
  id          String    @id @default(cuid())
  executionId String
  level       String    @default("info")
  scope       String
  message     String    @db.Text
  metadata    Json?
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([executionId, createdAt])
}

model ExecutionArtifact {
  id          String    @id @default(cuid())
  executionId String
  type        String
  name        String
  content     String?   @db.Text
  url         String?
  metadata    Json?
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([executionId])
}

model PullRequest {
  id             String            @id @default(cuid())
  executionId    String            @unique
  projectId      String
  demandId       String
  externalNumber Int
  url            String
  title          String
  status         PullRequestStatus @default(DRAFT)
  headBranch     String
  baseBranch     String
  mergedAt       DateTime?
  execution      Execution         @relation(fields: [executionId], references: [id], onDelete: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  demand         Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([projectId, externalNumber])
  @@index([demandId])
}

model HealthCheck {
  id             String       @id @default(cuid())
  projectId      String
  status         HealthStatus @default(UNKNOWN)
  responseTimeMs Int?
  statusCode     Int?
  summary        String?
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkedAt      DateTime     @default(now())

  @@index([projectId, checkedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  projectId  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?  @db.Text
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  projectId   String?
  provider    String
  deliveryId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?   @db.Text
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([provider, deliveryId])
  @@index([processedAt, createdAt])
}

model WorkerHeartbeat {
  id         String   @id
  host       String
  processId  Int
  startedAt  DateTime
  lastSeenAt DateTime

  @@index([lastSeenAt])
}

model GlobalSettings {
  id                               String   @id
  timeZone                         String   @default("America/Sao_Paulo")
  nodeMemoryMb                     Int      @default(384)
  commandTimeoutMinutes            Int      @default(10)
  agentTimeoutMinutes              Int      @default(5)
  parallelExecutions               Int      @default(2)
  executionProcessingEnabled       Boolean  @default(true)
  agentPowerMode                   String   @default("BALANCED")
  executionMaxAttempts             Int      @default(3)
  staleExecutionMinutes            Int      @default(30)
  healthCheckIntervalMinutes       Int      @default(5)
  healthCheckTimeoutSeconds        Int      @default(10)
  healthCheckConcurrency           Int      @default(10)
  healthCheckRetentionDays         Int      @default(30)
  previewPreparationTimeoutMinutes Int      @default(15)
  financialShadowEnabled           Boolean  @default(true)
  usdToBrlCents                    Int      @default(600)
  aiSafetyPercent                  Int      @default(15)
  targetGrossMarginPercent         Int      @default(80)
  creditValueCents                 Int      @default(10)
  reservationBufferPercent         Int      @default(20)
  creditBalanceSafetyMarginPercent Int      @default(20)
  workerCostCentsPerHour           Int      @default(100)
  visualValidationCostCents        Int      @default(10)
  updatedAt                        DateTime @updatedAt
}
